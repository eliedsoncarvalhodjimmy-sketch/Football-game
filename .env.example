# Smell CRM — variáveis de ambiente
# Copie este ficheiro para ".env.local" e preencha com os valores do seu projecto Supabase
# (Supabase > Project Settings > API). NUNCA envie o ".env.local" para o GitHub.

# Endereço do projecto Supabase (público, pode ir para o browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave pública "anon"/"publishable" (pública; a segurança é garantida pelas regras RLS da base de dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta "service_role" — SÓ no servidor (Vercel). Dá acesso total: nunca a partilhe.
# Usada apenas para o CEO criar contas de vendedores.
SUPABASE_SERVICE_ROLE_KEY=

# Email do CEO: a primeira conta com este email recebe o perfil CEO.
CEO_EMAIL=
