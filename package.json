{
  "name": "futceo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FutCEO — jogo de gestão de futebol para uso pessoal",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "importar-fontes": "tsx scripts/importar-fontes.ts",
    "validate-pack": "tsx src/cli/validate-pack.ts",
    "gen-world": "tsx src/cli/gen-world.ts",
    "simulate": "tsx src/cli/simulate.ts",
    "bench": "tsx src/cli/bench.ts",
    "players": "tsx src/cli/players.ts",
    "simulate-match": "tsx src/cli/simulate-match.ts",
    "club": "tsx src/cli/club.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
